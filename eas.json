{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "ios": {
        "simulator": false
      }
    },
    "preview": {
      "channel": "preview",
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_URL": "https://itc-backend-1031252664334.us-east1.run.app",
        "EXPO_PUBLIC_ENABLE_PREMIUM_SIMULATION": "true"
      },
      "ios": {
        "resourceClass": "m-medium"
      }
    },
    "production": {
      "channel": "production",
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_URL": "https://itc-backend-1031252664334.us-east1.run.app"
      },
      "ios": {
        "resourceClass": "m-medium"
      }
    }
  },
  "submit": {
    "preview": {
      "ios": {
        "appleId": "corevenlabs@gmail.com",
        "ascAppId": "6802768103",
        "appleTeamId": "XKA2G7T5XX"
      }
    },
    "production": {
      "ios": {
        "appleId": "corevenlabs@gmail.com",
        "ascAppId": "6802768103",
        "appleTeamId": "XKA2G7T5XX"
      }
    }
  }
}
