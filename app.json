{
  "expo": {
    "name": "ITC Club",
    "slug": "itc-club",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "itcclub",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.insightthecity.app",
      "icon": "./assets/expo.icon",
      "infoPlist": {
        "LSApplicationQueriesSchemes": [
          "itcclub",
          "itcclub",
          "itcclub",
          "itcclub"
        ],
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "android": {
            "image": "./assets/images/splash-icon.png",
            "imageWidth": 76
          }
        }
      ],
      "expo-font",
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Permite que ITC Club use Face ID para proteger y desbloquear tu sesión."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "f5ed8eb6-1918-470f-8f4f-9e68776661cf"
      }
    },
    "owner": "corevenlabs-dev",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/f5ed8eb6-1918-470f-8f4f-9e68776661cf"
    }
  }
}
