{
  "expo": {
    "name": "ITC Club",
    "slug": "itc-club",
    "version": "1.0.3",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "itcclub",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.insightthecity.app",
      "icon": "./assets/images/itc-app-icon-ny.png",
      "infoPlist": {
        "LSApplicationQueriesSchemes": [
          "itcclub"
        ],
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleAllowMixedLocalizations": true
      },
      "supportsTablet": true,
      "usesAppleSignIn": true,
      "runtimeVersion": {
        "policy": "fingerprint"
      }
    },
    "android": {
      "package": "com.insightthecity.app",
      "adaptiveIcon": {
        "backgroundColor": "#050505",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#050505",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 180
        }
      ],
      "expo-font",
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Permite que ITC Club use Face ID para proteger y desbloquear tu sesi\u00f3n."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Permite que Insight The City use una foto que elijas para tu perfil.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "ITC Club usa tu ubicaci\u00f3n solo cuando pides lugares cercanos en el chat, para mostrarte opciones cerca de ti. No guardamos tu ubicaci\u00f3n.",
          "locationAlwaysAndWhenInUsePermission": false,
          "locationAlwaysPermission": false,
          "motionUsagePermission": "ITC Club no usa los datos de movimiento de tu dispositivo. Este permiso solo existe porque lo incluye el componente de ubicaci\u00f3n del sistema; la app nunca lo solicita.",
          "isIosBackgroundLocationEnabled": false,
          "isAndroidBackgroundLocationEnabled": false
        }
      ],
      "expo-video",
      "expo-apple-authentication"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "f5ed8eb6-1918-470f-8f4f-9e68776661cf"
      }
    },
    "owner": "corevenlabs-dev",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/f5ed8eb6-1918-470f-8f4f-9e68776661cf"
    }
  }
}
